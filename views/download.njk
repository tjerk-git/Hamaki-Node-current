{% extends "base.njk" %}

{% block content %}

<section class="hero-section">
  <div class="hero-inner">
    <div class="hero-badge">macOS 15.0 or later &nbsp;·&nbsp; 7.6 MB</div>
    <h1 class="hero-headline">Download<br>Hamaki</h1>
    <p class="hero-sub">
      Available exclusively on the Mac App Store.
      Free to start — one click to install.
    </p>
    <div class="hero-actions">
      <a href="https://apps.apple.com/nl/app/hamaki/id1627733431?l=en-GB&mt=12"
         class="btn btn-primary" target="_blank" style="font-size:1.1rem;padding:0.9rem 2rem;">
        <i class="fab fa-apple"></i>
        Download on Mac App Store
      </a>
    </div>
    <p class="hero-note">Free with optional Pro upgrade &nbsp;·&nbsp; No account required &nbsp;·&nbsp; Your data stays on your Mac</p>
  </div>
</section>

<section>
  <div class="section-wrapper narrow">
    <div class="section-header center">
      <div class="section-label">System requirements</div>
      <h2 class="section-title">Requirements</h2>
    </div>

    <div style="background:#fff;border:1px solid var(--border);border-radius:14px;overflow:hidden;">
      <div style="display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--border);">
        <div style="padding:1.25rem 1.5rem;border-right:1px solid var(--border);">
          <div style="font-size:0.78rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-muted);margin-bottom:0.4rem;">Platform</div>
          <div style="font-weight:600;color:var(--text-dark);">Mac only</div>
        </div>
        <div style="padding:1.25rem 1.5rem;">
          <div style="font-size:0.78rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-muted);margin-bottom:0.4rem;">macOS</div>
          <div style="font-weight:600;color:var(--text-dark);">15.0 (Sequoia) or later</div>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;">
        <div style="padding:1.25rem 1.5rem;border-right:1px solid var(--border);">
          <div style="font-size:0.78rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-muted);margin-bottom:0.4rem;">Download size</div>
          <div style="font-weight:600;color:var(--text-dark);">7.6 MB</div>
        </div>
        <div style="padding:1.25rem 1.5rem;">
          <div style="font-size:0.78rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-muted);margin-bottom:0.4rem;">Language</div>
          <div style="font-weight:600;color:var(--text-dark);">English</div>
        </div>
      </div>
    </div>

    <div style="margin-top:3rem;">
      <div class="section-header center">
        <div class="section-label">After installing</div>
        <h2 class="section-title">Get started in 3 steps</h2>
      </div>

      <div style="display:flex;flex-direction:column;gap:1rem;">
        <div style="display:flex;align-items:flex-start;gap:1rem;background:#fff;border:1px solid var(--border);border-radius:12px;padding:1.25rem 1.5rem;">
          <div style="width:36px;height:36px;border-radius:8px;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-family:'Thunder',sans-serif;font-size:1.2rem;flex-shrink:0;">1</div>
          <div>
            <div style="font-weight:600;color:var(--text-dark);margin-bottom:0.2rem;">Open Hamaki from your Applications folder</div>
            <div style="font-size:0.88rem;color:var(--text-muted);">It appears in your menu bar. Click the icon to open the main window.</div>
          </div>
        </div>
        <div style="display:flex;align-items:flex-start;gap:1rem;background:#fff;border:1px solid var(--border);border-radius:12px;padding:1.25rem 1.5rem;">
          <div style="width:36px;height:36px;border-radius:8px;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-family:'Thunder',sans-serif;font-size:1.2rem;flex-shrink:0;">2</div>
          <div>
            <div style="font-weight:600;color:var(--text-dark);margin-bottom:0.2rem;">Create your first booking calendar</div>
            <div style="font-size:0.88rem;color:var(--text-muted);">Connect Calendar.app or create a standalone calendar — no permissions required for the latter.</div>
          </div>
        </div>
        <div style="display:flex;align-items:flex-start;gap:1rem;background:#fff;border:1px solid var(--border);border-radius:12px;padding:1.25rem 1.5rem;">
          <div style="width:36px;height:36px;border-radius:8px;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-family:'Thunder',sans-serif;font-size:1.2rem;flex-shrink:0;">3</div>
          <div>
            <div style="font-weight:600;color:var(--text-dark);margin-bottom:0.2rem;">Draw spots and share your booking link</div>
            <div style="font-size:0.88rem;color:var(--text-muted);">Drag to mark available times. Copy your unique booking URL and share it. Done.</div>
          </div>
        </div>
      </div>

      <div style="text-align:center;margin-top:2rem;">
        <a href="https://hamaki-docs.raymond.frl" target="_blank" class="btn btn-outline">
          Read the full docs →
        </a>
      </div>
    </div>
  </div>
</section>

<section class="cta-banner">
  <h2>Questions before downloading?</h2>
  <p>Check the docs or reach out — we're happy to help.</p>
  <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
    <a href="/support" class="btn btn-primary">Go to Support</a>
    <a href="/pricing" class="btn btn-secondary">See Pricing</a>
  </div>
</section>

{% endblock %}
